<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ review.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --paper:#fbfaf8; --surface:#ffffff; --surface-2:#f4f2ec;
    --ink:#1b2230; --ink-soft:#59616f; --ink-faint:#8b909b;
    --rule:#e5e2da; --rule-strong:#d3cfc4;
    --accent:#0e7c7b; --accent-deep:#0b5c5b;
    --g:#2f8f5b; --g-bg:#e8f2ea;
    --a:#bd7f16; --a-bg:#f7efdd;
    --r:#c0392f; --r-bg:#f7e4e2;
    --shadow:0 1px 2px rgba(20,25,35,.04), 0 8px 24px -12px rgba(20,25,35,.10);
    --maxw:70rem;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#14171d; --surface:#1b1f27; --surface-2:#20242d;
      --ink:#e9eaee; --ink-soft:#a6adb8; --ink-faint:#767d89;
      --rule:#2a2f39; --rule-strong:#3a4051;
      --accent:#3ba3a0; --accent-deep:#4fb6b2;
      --g:#4caf7a; --g-bg:#182a22;
      --a:#d69f45; --a-bg:#2c2416;
      --r:#d9635a; --r-bg:#2e1c1b;
      --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px -14px rgba(0,0,0,.55);
    }
  }
  :root[data-theme="dark"]{
    --paper:#14171d; --surface:#1b1f27; --surface-2:#20242d;
    --ink:#e9eaee; --ink-soft:#a6adb8; --ink-faint:#767d89;
    --rule:#2a2f39; --rule-strong:#3a4051;
    --accent:#3ba3a0; --accent-deep:#4fb6b2;
    --g:#4caf7a; --g-bg:#182a22;
    --a:#d69f45; --a-bg:#2c2416;
    --r:#d9635a; --r-bg:#2e1c1b;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px -14px rgba(0,0,0,.55);
  }

  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:"Libre Franklin", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size:15px; line-height:1.62; -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 clamp(18px,4vw,44px) 96px}
  h1,h2,h3,h4{margin:0; font-weight:600; text-wrap:balance; letter-spacing:-.01em}
  p{margin:0}
  a{color:var(--accent); text-decoration:none}
  a:hover{text-decoration:underline}
  strong{font-weight:600}
  .mono{font-family:"IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace}
  .num{font-variant-numeric:tabular-nums}

  /* ---------- cover ---------- */
  .cover{
    padding:56px 0 30px; border-bottom:2px solid var(--ink);
    margin-bottom:8px;
  }
  .eyebrow{
    font-size:11.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
    color:var(--accent-deep);
  }
  .cover h1{
    font-family:"Newsreader", Georgia, serif; font-weight:500;
    font-size:clamp(30px,5vw,44px); line-height:1.1; margin:14px 0 18px;
    letter-spacing:-.015em;
  }
  .cover-meta{
    display:flex; flex-wrap:wrap; gap:6px 34px; font-size:13px; color:var(--ink-soft);
  }
  .cover-meta b{color:var(--ink); font-weight:600}
  .cover-meta .k{
    font-size:10.5px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--ink-faint); display:block; margin-bottom:1px;
  }

  /* ---------- status strip ---------- */
  .statusstrip{
    display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px;
    background:var(--rule); border:1px solid var(--rule); border-radius:10px;
    overflow:hidden; margin:26px 0 8px;
  }
  @media (max-width:720px){.statusstrip{grid-template-columns:repeat(2,1fr)}}
  .stat{background:var(--surface); padding:13px 15px}
  .stat .k{font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); line-height:1.25}
  .stat .v{font-family:"IBM Plex Mono",monospace; font-size:19px; font-weight:500; margin-top:5px; letter-spacing:-.02em}
  .stat .d{font-size:11px; margin-top:5px; color:var(--ink-soft); display:flex; flex-wrap:wrap; gap:4px 6px; align-items:center}
  .stat .d .sep{flex-basis:100%; height:0}
  .fav{color:var(--g)} .adv{color:var(--r)}

  /* ---------- sections ---------- */
  section{margin-top:52px; scroll-margin-top:20px}
  .sec-head{display:flex; align-items:baseline; gap:8px 14px; margin-bottom:18px; flex-wrap:wrap}
  .sec-no{
    font-family:"IBM Plex Mono",monospace; font-size:12px; font-weight:600;
    color:var(--accent-deep); border:1px solid var(--accent); border-radius:5px;
    padding:2px 7px; flex:none;
  }
  .sec-head h2{font-size:19px; letter-spacing:-.015em}
  .sec-head .sub{color:var(--ink-faint); font-size:12.5px; margin-left:auto; text-align:right}

  /* ---------- exec summary ---------- */
  .bottomline{
    font-family:"Newsreader", Georgia, serif; font-size:19px; line-height:1.5;
    border-left:3px solid var(--accent); padding:6px 0 6px 20px; margin-bottom:22px;
    color:var(--ink);
  }
  .prose{max-width:40rem}
  .prose p{font-family:"Newsreader", Georgia, serif; font-size:15.5px; line-height:1.68; margin-bottom:12px; color:var(--ink)}
  .prose p strong{font-family:"Libre Franklin",sans-serif; font-size:14px}
  .changes{
    margin-top:20px; border-top:1px solid var(--rule); padding-top:16px;
    display:grid; gap:8px;
  }
  .changes .lbl{font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:2px}
  .chg{display:flex; gap:10px; align-items:baseline; font-size:13px}
  .chg .dot{width:7px; height:7px; border-radius:50%; flex:none; margin-top:5px}
  .chg.up .dot{background:var(--g)} .chg.down .dot{background:var(--r)} .chg.flat .dot{background:var(--ink-faint)}

  /* ---------- scorecard table ---------- */
  .tablecard{border:1px solid var(--rule); border-radius:10px; overflow:hidden; box-shadow:var(--shadow)}
  .scroll-x{overflow-x:auto}
  table{border-collapse:collapse; width:100%; font-size:12.5px}
  thead th{
    background:var(--surface-2); text-align:right; font-weight:600; font-size:9.5px;
    letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft);
    padding:9px 9px; border-bottom:1px solid var(--rule-strong); white-space:nowrap;
  }
  thead th:first-child, tbody td:first-child{text-align:left}
  tbody td{padding:9px 9px; text-align:right; border-bottom:1px solid var(--rule); white-space:nowrap}
  tbody td.strong{color:var(--ink); font-weight:600}
  tbody td.muted{color:var(--ink-faint)}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover td{background:var(--surface-2)}
  tbody td:first-child{white-space:normal; width:32%; line-height:1.3; padding-left:12px}
  thead th:first-child{padding-left:12px}
  .kpi-name{font-weight:600; color:var(--ink)}
  .kpi-cat{display:block; font-size:10px; font-weight:500; color:var(--ink-faint); letter-spacing:.02em; text-transform:none; margin-top:1px}
  .headline-row td:first-child .kpi-name::before{
    content:""; display:inline-block; width:6px; height:6px; border-radius:50%;
    background:var(--accent); margin-right:7px; vertical-align:middle;
  }
  .spark{display:block; color:var(--ink-faint)}
  td .spark{margin-left:auto}
  .chip{
    display:inline-block; min-width:54px; text-align:center; font-family:"IBM Plex Mono",monospace;
    font-size:10px; font-weight:600; padding:3px 7px; border-radius:999px; letter-spacing:.03em;
  }
  .chip.green{background:var(--g-bg); color:var(--g)}
  .chip.amber{background:var(--a-bg); color:var(--a)}
  .chip.red{background:var(--r-bg); color:var(--r)}
  .chip.grey{background:var(--surface-2); color:var(--ink-faint)}
  .delta.fav{color:var(--g)} .delta.adv{color:var(--r)} .delta.neutral{color:var(--ink-faint)}
  .tg{font-size:11px; color:var(--ink-faint)}
  .tg.improving{color:var(--g)} .tg.deteriorating{color:var(--r)}

  /* ---------- headline charts ---------- */
  .chartgrid{display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; margin-top:16px}
  .chartcard{border:1px solid var(--rule); border-radius:10px; padding:14px 14px 8px; background:var(--surface)}
  .chartcard .ch-h{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px}
  .chartcard .ch-h .t{font-size:12px; font-weight:600; letter-spacing:.02em}
  .chartcard .ch-h .v{font-family:"IBM Plex Mono",monospace; font-size:13px; font-weight:600}
  .linechart{width:100%; height:auto; display:block}
  .linechart .grid{stroke:var(--rule); stroke-width:1}
  .linechart .ytick,.linechart .xtick{fill:var(--ink-faint); font-size:9px; font-family:"IBM Plex Mono",monospace}
  .linechart .ref-target{stroke:var(--accent); stroke-width:1.2; stroke-dasharray:4 3; opacity:.8}
  .linechart .ref-amber{stroke:var(--a); stroke-width:1; stroke-dasharray:2 3; opacity:.5}
  .linechart .ref-label{fill:var(--accent); font-size:8.5px; font-family:"IBM Plex Mono",monospace}

  /* ---------- BU cards ---------- */
  .bugrid{display:grid; gap:16px}
  .bucard{border:1px solid var(--rule); border-radius:12px; background:var(--surface); box-shadow:var(--shadow); overflow:hidden}
  .bucard-top{display:flex; flex-wrap:wrap; gap:16px 22px; align-items:flex-start; padding:18px 20px; border-bottom:1px solid var(--rule)}
  .bucard-top h3{font-size:16px; letter-spacing:-.01em}
  .bu-verdict{font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; padding:3px 9px; border-radius:999px; margin-top:6px; display:inline-block}
  .bu-verdict.escalate{background:var(--r-bg); color:var(--r)}
  .bu-verdict.watch{background:var(--a-bg); color:var(--a)}
  .bu-verdict.ontrack, .bu-verdict.ontrack-improving{background:var(--g-bg); color:var(--g)}
  .bu-score{margin-left:auto; text-align:right; flex:none}
  .bu-score .n{font-family:"IBM Plex Mono",monospace; font-size:26px; font-weight:600; letter-spacing:-.03em; display:block; line-height:1}
  .bu-score .l{font-size:10px; letter-spacing:.09em; text-transform:uppercase; color:var(--ink-faint)}
  .ragbar{display:block; margin-top:7px; border-radius:3px; overflow:hidden}
  .bu-readout{padding:14px 20px 4px; font-size:13px; color:var(--ink-soft); max-width:44rem}
  .bucard-body{display:grid; grid-template-columns:1.15fr 1fr; gap:8px 26px; padding:12px 20px 20px}
  @media (max-width:720px){.bucard-body{grid-template-columns:1fr}}
  .mini{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--rule); border:1px solid var(--rule); border-radius:8px; overflow:hidden; align-self:start}
  .mini .cell{background:var(--surface); padding:9px 11px; min-height:56px}
  .mini .cell .l{font-size:9.5px; letter-spacing:.03em; text-transform:uppercase; color:var(--ink-faint); display:flex; justify-content:space-between; align-items:baseline; gap:6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .mini .cell .row{display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:4px}
  .mini .cell .val{font-family:"IBM Plex Mono",monospace; font-size:13.5px; font-weight:600; white-space:nowrap}
  .mini .cell .val .wow{font-size:10px; font-weight:500; color:var(--ink-faint); margin-left:5px}
  .dotb{width:7px; height:7px; border-radius:50%; flex:none}
  .dotb.green{background:var(--g)} .dotb.amber{background:var(--a)} .dotb.red{background:var(--r)} .dotb.grey{background:var(--ink-faint)}
  .bu-chart .cap{font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:4px}

  /* ---------- watch items ---------- */
  .watchlist{display:grid; gap:1px; background:var(--rule); border:1px solid var(--rule); border-radius:10px; overflow:hidden}
  .witem{background:var(--surface); padding:13px 16px 13px 18px; position:relative}
  .witem::before{content:""; position:absolute; left:0; top:0; bottom:0; width:4px}
  .witem.high::before{background:var(--r)}
  .witem.medium::before{background:var(--a)}
  .witem .wt{font-size:13px; font-weight:600}
  .witem .wd{font-size:12px; color:var(--ink-soft); margin-top:3px}
  .witem .sev{font-size:9.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; float:right; margin-left:12px}
  .witem.high .sev{color:var(--r)} .witem.medium .sev{color:var(--a)}
  .noflag{border:1px dashed var(--rule-strong); border-radius:10px; padding:16px; font-size:13px; color:var(--ink-soft)}

  /* ---------- recommendations ---------- */
  .recs{display:grid; gap:12px; counter-reset:rec}
  .rec{border:1px solid var(--rule); border-radius:10px; padding:15px 18px; background:var(--surface); box-shadow:var(--shadow)}
  .rec h4{font-size:14.5px; display:flex; gap:10px; align-items:baseline}
  .rec h4::before{
    counter-increment:rec; content:"R" counter(rec);
    font-family:"IBM Plex Mono",monospace; font-size:11px; font-weight:600; color:var(--accent-deep);
    border:1px solid var(--accent); border-radius:5px; padding:1px 6px; flex:none;
  }
  .rec p{font-size:12.5px; color:var(--ink-soft); margin:7px 0 10px}
  .rec .meta{display:flex; flex-wrap:wrap; gap:8px}
  .tag{font-size:10.5px; letter-spacing:.03em; background:var(--surface-2); color:var(--ink-soft); padding:3px 9px; border-radius:999px}
  .tag b{color:var(--ink); font-weight:600}

  /* ---------- appendix ---------- */
  .defs{width:100%; border-collapse:collapse; font-size:12.5px; table-layout:fixed}
  .defs th{text-align:left; font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); padding:8px 12px; border-bottom:1px solid var(--rule-strong)}
  .defs td{padding:10px 12px; border-bottom:1px solid var(--rule); vertical-align:top; white-space:normal; text-align:left; line-height:1.5}
  .defs td:first-child{font-weight:600; color:var(--ink)}
  .defs col.c-kpi{width:20%} .defs col.c-def{width:48%} .defs col.c-tgt{width:14%} .defs col.c-rag{width:18%}
  .defs .tgt{font-family:"IBM Plex Mono",monospace; color:var(--ink-soft); font-size:11.5px}

  /* ---------- footer ---------- */
  .foot{margin-top:64px; padding-top:18px; border-top:1px solid var(--rule); font-size:11.5px; color:var(--ink-faint); display:flex; flex-wrap:wrap; gap:6px 20px; justify-content:space-between}

  .toc{
    display:flex; flex-wrap:wrap; gap:6px 18px; font-size:12px; margin:24px 0 4px;
    color:var(--ink-soft);
  }
  .toc a{color:var(--ink-soft)}
  .toc a:hover{color:var(--accent)}

  @media (prefers-reduced-motion:no-preference){
    a,.witem,tbody tr{transition:color .12s ease, background .12s ease}
  }
  @media print{
    body{background:#fff; font-size:11px}
    .wrap{max-width:none; padding:0}
    .toc, .foot .gen{display:none}
    section{page-break-inside:avoid; margin-top:26px}
    .bucard, .rec, .chartcard{break-inside:avoid}
    .tablecard, .bucard, .rec{box-shadow:none}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="cover">
    <span class="eyebrow">Service Review &amp; Insights — Board Pack</span>
    <h1>{{ review.title }}</h1>
    <div class="cover-meta">
      <span><span class="k">Reporting period</span><b>{{ review.period_label }}</b></span>
      <span><span class="k">Prepared for</span><b>{{ review.prepared_for }}</b></span>
      <span><span class="k">Prepared by</span><b>{{ review.prepared_by }}</b></span>
      <span><span class="k">Units in scope</span><b>{{ cfg.business_units | length }} voice operations</b></span>
      <span><span class="k">Contacts handled</span><b>{{ '{:,}'.format(group.quarter_contacts) }} this quarter</b></span>
    </div>

    <div class="statusstrip four">
      {% set g = group.kpis %}
      <div class="stat">
        <div class="k">Group Service Level</div>
        <div class="v num">{{ g.service_level.fmt.format(g.service_level.current) }}</div>
        <div class="d"><span class="{{ 'fav' if g.service_level.favourable_q else 'adv' }}">{{ '%+.1f'|format(g.service_level.q_delta) }}pt</span> vs qtr start<span class="sep"></span><span class="chip {{ g.service_level.rag }}" style="min-width:0">{{ g.service_level.rag|upper }}</span></div>
      </div>
      <div class="stat">
        <div class="k">Abandonment</div>
        <div class="v num">{{ g.abandon_rate.fmt.format(g.abandon_rate.current) }}</div>
        <div class="d"><span class="{{ 'fav' if g.abandon_rate.favourable_q else 'adv' }}">{{ '%+.1f'|format(g.abandon_rate.q_delta) }}pt</span> vs qtr start<span class="sep"></span><span class="chip {{ g.abandon_rate.rag }}" style="min-width:0">{{ g.abandon_rate.rag|upper }}</span></div>
      </div>
      <div class="stat">
        <div class="k">CSAT</div>
        <div class="v num">{{ g.csat.fmt.format(g.csat.current) }}</div>
        <div class="d"><span class="{{ 'fav' if g.csat.favourable_q else 'adv' }}">{{ '%+.1f'|format(g.csat.q_delta) }}pt</span> vs qtr start<span class="sep"></span><span class="chip {{ g.csat.rag }}" style="min-width:0">{{ g.csat.rag|upper }}</span></div>
      </div>
      <div class="stat">
        <div class="k">Cost / Contact</div>
        <div class="v num">{{ g.cost_per_contact.fmt.format(g.cost_per_contact.current) }}</div>
        <div class="d"><span class="{{ 'fav' if g.cost_per_contact.favourable_q else 'adv' }}">{{ '%+.2f'|format(g.cost_per_contact.q_delta) }}</span> vs qtr start<span class="sep"></span><span class="chip {{ g.cost_per_contact.rag }}" style="min-width:0">{{ g.cost_per_contact.rag|upper }}</span></div>
      </div>
    </div>

    <nav class="toc" aria-label="Contents">
      <a href="#s1">1 · Executive summary</a>
      <a href="#s2">2 · Group scorecard</a>
      <a href="#s3">3 · Business-unit review</a>
      <a href="#s4">4 · Watch items &amp; anomalies</a>
      <a href="#s5">5 · Recommended actions</a>
      <a href="#s6">6 · Appendix — KPI definitions</a>
    </nav>
  </header>

  <!-- 1 · EXECUTIVE SUMMARY -->
  <section id="s1">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>Executive summary</h2>
      <span class="sub">Generated {{ generated }}<br>from {{ weeks|length }} weeks of weekly operational data</span>
    </div>
    <p class="bottomline">{{ bottom_line | safe }}</p>
    <div class="prose">
      {% for p in exec_summary %}<p>{{ p | safe }}</p>{% endfor %}
    </div>
    <div class="changes">
      <span class="lbl">What moved this quarter</span>
      {% for c in what_changed %}
      <div class="chg {{ 'up' if c.favourable else 'down' if c.favourable == false else 'flat' }}">
        <span class="dot"></span><span>{{ c.text }}</span>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 2 · GROUP SCORECARD -->
  <section id="s2">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <h2>Group scorecard</h2>
      <span class="sub">Volume-weighted across all units · RAG vs standardised target</span>
    </div>
    <div class="tablecard scroll-x">
      <table>
        <thead>
          <tr>
            <th>KPI</th><th>Latest</th><th>Target</th><th>WoW</th><th>Qtr&nbsp;Δ</th>
            <th>13-week trend</th><th>vs&nbsp;Target</th>
          </tr>
        </thead>
        <tbody>
          {% for r in scorecard %}
          <tr class="{{ 'headline-row' if r.headline }}">
            <td>
              <span class="kpi-name">{{ r.label }}</span>
              <span class="kpi-cat">{{ r.category }}</span>
            </td>
            <td class="mono num strong">{{ r.current }}</td>
            <td class="mono num muted">{{ r.target }}</td>
            <td class="mono num delta {{ 'fav' if r.wow_fav else 'adv' if r.wow_fav == false else 'neutral' }}">{{ r.wow }}</td>
            <td class="mono num delta {{ 'fav' if r.q_fav else 'adv' if r.q_fav == false else 'neutral' }}">{{ r.q_delta }}</td>
            <td>{{ r.spark | safe }}</td>
            <td><span class="chip {{ r.rag }}">{{ r.rag|upper }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="chartgrid">
      {% for c in headline_charts %}
      <div class="chartcard">
        <div class="ch-h"><span class="t">{{ c.label }}</span><span class="v" style="color:var(--{{ 'g' if c.rag=='green' else 'a' if c.rag=='amber' else 'r' }})">{{ c.current }}</span></div>
        {{ c.chart | safe }}
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 3 · BUSINESS-UNIT REVIEW -->
  <section id="s3">
    <div class="sec-head">
      <span class="sec-no">03</span>
      <h2>Business-unit review</h2>
      <span class="sub">Ordered by headline-KPI score, weakest last</span>
    </div>
    <div class="bugrid">
      {% for b in bu_blocks %}
      <article class="bucard">
        <div class="bucard-top">
          <div>
            <h3>{{ b.name }}</h3>
            <span class="bu-verdict {{ b.verdict|lower|replace(' — ','-')|replace(' ','-') }}">{{ b.verdict }}</span>
          </div>
          <div class="bu-score">
            <span class="n num">{{ b.score|round|int }}</span>
            <span class="l">/100 headline</span>
            {{ b.rag_bar | safe }}
          </div>
        </div>
        <p class="bu-readout">{{ b.readout }}</p>
        <div class="bucard-body">
          <div class="mini">
            {% for m in b.mini %}
            <div class="cell" title="{{ m.label }}">
              <span class="l">{{ m.short }} <span class="tg {{ m.trend }}">{{ m.trend_glyph }}</span></span>
              <div class="row">
                <span class="val num">{{ m.value }}<span class="wow num">{{ m.wow }}</span></span>
                <span class="dotb {{ m.rag }}" title="{{ m.rag }}"></span>
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="bu-chart">
            <div class="cap">Service Level · 13 weeks vs 80% target</div>
            {{ b.sl_chart | safe }}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  <!-- 4 · WATCH ITEMS -->
  <section id="s4">
    <div class="sec-head">
      <span class="sec-no">04</span>
      <h2>Watch items &amp; anomalies</h2>
      <span class="sub">{{ anomaly_count }} statistical anomal{{ 'y' if anomaly_count == 1 else 'ies' }} · z &gt; {{ cfg.review.anomaly_z_threshold }} vs trailing {{ cfg.review.anomaly_baseline_weeks }}-week mean</span>
    </div>
    {% if watch %}
    <div class="watchlist">
      {% for w in watch %}
      <div class="witem {{ w.severity }}">
        <span class="sev">{{ w.severity }}</span>
        <div class="wt">{{ w.title }}</div>
        <div class="wd">{{ w.detail }}</div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="noflag">No metric breached the anomaly or step-change thresholds this cycle.</div>
    {% endif %}
  </section>

  <!-- 5 · RECOMMENDATIONS -->
  <section id="s5">
    <div class="sec-head">
      <span class="sec-no">05</span>
      <h2>Recommended actions</h2>
      <span class="sub">Owner and horizon assigned · tracked to next review</span>
    </div>
    <div class="recs">
      {% for r in recs %}
      <div class="rec">
        <h4>{{ r.title }}</h4>
        <p>{{ r.rationale }}</p>
        <div class="meta">
          <span class="tag">Owner: <b>{{ r.owner }}</b></span>
          <span class="tag">Horizon: <b>{{ r.horizon }}</b></span>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 6 · APPENDIX -->
  <section id="s6">
    <div class="sec-head">
      <span class="sec-no">06</span>
      <h2>Appendix — standardised KPI definitions</h2>
      <span class="sub">Single source of truth · applied identically to every unit</span>
    </div>
    <div class="tablecard scroll-x">
      <table class="defs">
        <colgroup><col class="c-kpi"><col class="c-def"><col class="c-tgt"><col class="c-rag"></colgroup>
        <thead><tr><th>KPI</th><th>Definition</th><th>Target</th><th>RAG rule</th></tr></thead>
        <tbody>
          {% for k in kpi_defs %}
          <tr>
            <td>{{ k.label }}</td>
            <td>{{ k.definition }}</td>
            <td class="tgt">
              {%- if k.direction == 'band' -%}{{ k.band_low }}–{{ k.band_high }}{{ k.unit }}
              {%- else -%}{{ k.fmt.format(k.target) }}{%- endif -%}
            </td>
            <td class="tgt">
              {%- if k.direction == 'higher_better' -%}green ≥ {{ k.fmt.format(k.target) }} · red &lt; {{ k.fmt.format(k.amber) }}
              {%- elif k.direction == 'lower_better' -%}green ≤ {{ k.fmt.format(k.target) }} · red &gt; {{ k.fmt.format(k.amber) }}
              {%- else -%}green inside band
              {%- endif -%}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <div class="foot">
    <span>{{ review.title }} · {{ review.period_label }} · Confidential — internal governance use</span>
    <span class="gen">Auto-generated by the Service Review &amp; Insights pipeline on {{ generated }}. Data in this POC is synthetic.</span>
  </div>

</div>
</body>
</html>
